          "values": {
            "温度": 25
          },
          "container": "SN-EVAL-001"
        }
      },
      {
        "text": "先别执行，温度改成30，请重新展示计划",
        "expect": {
          "stage": "preview",
          "values": {
            "温度": 30
          },
          "container": "SN-EVAL-001"
        }
      },
      {
        "text": "确认",
        "expect": {
          "stage": "submitted",
          "values": {
            "温度": 30
          }
        }
      }
    ]
  },
